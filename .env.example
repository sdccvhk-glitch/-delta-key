# Copy this file's variable NAMES into Vercel Project Settings -> Environment
# Variables. Never commit a file containing your real values.

# Required: your Firebase service account, as ONE line of JSON.
# Get it from Firebase Console -> Project Settings -> Service Accounts ->
# Generate New Private Key. Paste the entire downloaded file's content here.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Admin panel login (created on first run if not already set in Firestore)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Default UPI receiving details (can also be changed later from the admin panel)
UPI_ID=yourname@upi
PAYMENT_PAYEE_NAME=DELTA.KEYS

# Optional: Telegram approval bot (webhook mode)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
